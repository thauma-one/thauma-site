---
permalink: /404.html
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>404 · Thauma</title>
<meta name="robots" content="noindex">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@100;200;300;600;800&family=Inter:wght@200;300;400;600&display=swap" rel="stylesheet">
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/css/main.css">
<style>
  /* This single file serves every broken URL regardless of language
     prefix, so — unlike every other page — language here is a runtime
     toggle, not a build-time pagination. Both languages render; JS
     shows one. */
  [data-lang-block][hidden]{display:none}
  main{display:flex;flex-direction:column;justify-content:center}

  {%- if not env.isProduction %}
  /* ---- GAME-SPEC.md Phase 1 (dev-only) ---- */
  .dict-word{cursor:text;display:inline-block}
  .thauma-char{display:inline-block}

  /* Real glitch: RGB-split text-shadow + chunky jittery steps, not a fade */
  @keyframes thauma-glitch{
    0%,100%{transform:translate(0,0);text-shadow:none;filter:none}
    7%{transform:translate(-4px,2px);text-shadow:3px 0 #ff2d6a,-3px 0 #2FD8FF;filter:brightness(1.3)}
    14%{transform:translate(3px,-3px);text-shadow:none;filter:contrast(1.5)}
    21%{transform:translate(-5px,1px);text-shadow:-4px 1px #ff2d6a,4px -1px #5CF2C4}
    28%{transform:translate(4px,-1px) skewX(3deg);filter:none}
    35%{transform:translate(-2px,3px);text-shadow:3px 0 #ff2d6a,-3px 0 #2FD8FF;filter:brightness(1.4)}
    42%{transform:translate(0,0);text-shadow:none}
    49%{transform:translate(-6px,-2px);text-shadow:-3px 0 #ff2d6a,3px 0 #2FD8FF;filter:contrast(1.6)}
    56%{transform:translate(5px,2px) skewX(-2deg)}
    63%{transform:translate(-3px,0);text-shadow:none;filter:none}
    70%{transform:translate(2px,-2px);text-shadow:2px 1px #ff2d6a,-2px -1px #5CF2C4}
    100%{transform:translate(0,0);text-shadow:none;filter:none}
  }
  .thauma-pulse{animation:thauma-glitch .7s steps(1,end)}

  /* Screen-wide glitch burst for the trail/warming effects and death moment */
  @keyframes thauma-screen-glitch{
    0%,100%{filter:none;transform:translate(0,0)}
    10%{filter:invert(.12) hue-rotate(200deg);transform:translate(-6px,0)}
    20%{filter:contrast(1.8) brightness(1.3);transform:translate(5px,0)}
    30%{filter:none;transform:translate(-4px,0)}
    40%{filter:hue-rotate(60deg) saturate(2);transform:translate(6px,0)}
    50%{filter:invert(.08);transform:translate(-3px,0)}
    60%{filter:none;transform:translate(4px,0)}
    70%{filter:contrast(1.5);transform:translate(-5px,0)}
    85%{filter:none;transform:translate(0,0)}
  }
  html.thauma-screen-glitch{animation:thauma-screen-glitch .4s steps(1,end)}

  #thauma-scanlines{position:fixed;inset:0;z-index:9998;pointer-events:none;opacity:0;
    background:repeating-linear-gradient(0deg,rgba(255,255,255,.09) 0 1px,transparent 1px 3px),
      repeating-linear-gradient(90deg,rgba(47,216,255,.06) 0 2px,transparent 2px 5px)}
  #thauma-scanlines.show{opacity:1}

  #thauma-game{position:fixed;inset:0;z-index:50;background:#0B0F15;
    opacity:0;visibility:hidden;pointer-events:none;transition:opacity .8s ease}
  #thauma-game.open{opacity:1;visibility:visible;pointer-events:auto}
  #thauma-game canvas{position:absolute;inset:0;width:100%;height:100%}
  #thauma-game.shake{animation:thauma-shake .35s steps(1,end)}
  @keyframes thauma-shake{
    0%,100%{transform:translate(0,0)}
    20%{transform:translate(-10px,6px)}
    40%{transform:translate(8px,-8px)}
    60%{transform:translate(-6px,-4px)}
    80%{transform:translate(10px,3px)}
  }

  .thauma-hud{position:absolute;top:12px;left:0;right:0;padding:22px 24px;display:flex;
    justify-content:space-between;align-items:flex-start;font-family:'Sora',sans-serif;
    pointer-events:none;z-index:2}
  .thauma-hud .signal{font-size:13px;letter-spacing:.2em;text-transform:uppercase;color:var(--dim)}
  .thauma-hud .signal b{color:var(--text);font-weight:600;font-size:20px;margin-left:8px}

  /* Bottom neon track with a slow "breathing" glow, instead of a flat bar
     stuck at the very edge */
  .thauma-track{position:absolute;bottom:34px;left:24px;right:24px;height:3px;
    background:rgba(255,255,255,.12);border-radius:2px;z-index:2}
  .thauma-track i{position:absolute;left:0;top:-1px;height:5px;border-radius:3px;
    background:linear-gradient(90deg,var(--blue),var(--blue-hi));
    box-shadow:0 0 10px 2px rgba(47,216,255,.6),0 0 22px 4px rgba(47,216,255,.3);
    transition:width .1s linear;animation:thauma-track-breathe 2.6s ease-in-out infinite}
  @keyframes thauma-track-breathe{
    0%,100%{box-shadow:0 0 10px 2px rgba(47,216,255,.6),0 0 22px 4px rgba(47,216,255,.3)}
    50%{box-shadow:0 0 16px 4px rgba(47,216,255,.85),0 0 34px 8px rgba(47,216,255,.5)}
  }
  .thauma-tick{position:absolute;bottom:-7px;width:4px;height:16px;background:var(--dim);border-radius:1px}
  .thauma-tick.summit{width:6px;height:26px;bottom:-11px;background:var(--foam);box-shadow:var(--foam-glow)}
  .thauma-tick .tick-mark{position:absolute;bottom:100%;left:50%;transform:translateX(-50%);
    width:7px;height:7px;border-radius:50%;background:var(--dim);margin-bottom:4px;
    animation:thauma-tick-pulse 2.2s ease-in-out infinite}
  .thauma-tick.summit .tick-mark{width:10px;height:10px;background:var(--foam);box-shadow:var(--foam-glow)}
  @keyframes thauma-tick-pulse{0%,100%{opacity:.55;transform:translateX(-50%) scale(1)}50%{opacity:1;transform:translateX(-50%) scale(1.35)}}

  .thauma-overlay{position:absolute;inset:0;z-index:3;display:flex;align-items:center;justify-content:center;
    text-align:center;background:rgba(11,15,21,.82);backdrop-filter:blur(3px);
    opacity:0;visibility:hidden;pointer-events:none;transition:opacity .5s ease}
  .thauma-overlay.show{opacity:1;visibility:visible;pointer-events:auto}
  .thauma-overlay .panel{max-width:460px;padding:0 24px}
  .thauma-overlay .taunt{font-family:'Sora';font-weight:200;font-size:clamp(20px,3.6vw,28px);margin-bottom:18px}
  .thauma-overlay .stats{color:var(--dim);font-size:13px;letter-spacing:.08em;margin-bottom:30px;line-height:2}
  .thauma-overlay .stats b{color:var(--foam)}
  .thauma-overlay .home-word{font-family:'Sora';font-weight:100;font-size:clamp(50px,9vw,100px);
    letter-spacing:.06em;margin-bottom:8px;text-shadow:0 0 50px rgba(47,216,255,.25)}
  .thauma-overlay .home-tag{color:var(--dim);font-size:13px;letter-spacing:.1em;margin-bottom:30px}

  /* Per-character scatter — each char gets its own JS-set --dx/--dy/--rot */
  @keyframes thauma-char-fall{
    0%{transform:translate(0,0) rotate(0deg);opacity:1;filter:none}
    30%{text-shadow:3px 0 #ff2d6a,-3px 0 #2FD8FF}
    100%{transform:translate(var(--dx,0),var(--dy,60px)) rotate(var(--rot,10deg));opacity:0;filter:blur(2px)}
  }
  .thauma-collapsing .thauma-char{animation:thauma-char-fall 1.1s cubic-bezier(.4,.6,.3,1) forwards}
  .thauma-collapsing .thauma-char:nth-child(1){animation-delay:0s}
  .thauma-collapsing .thauma-char:nth-child(2){animation-delay:.08s}
  .thauma-collapsing .thauma-char:nth-child(3){animation-delay:.16s}

  /* Everything else on the page shatters too, each with its own trajectory */
  @keyframes thauma-shatter{
    0%{transform:translate(0,0) rotate(0deg);opacity:1}
    100%{transform:translate(var(--dx,0),var(--dy,40px)) rotate(var(--rot,6deg));opacity:0;filter:blur(3px)}
  }
  .thauma-collapsing .thauma-shatter-piece{animation:thauma-shatter 1.3s ease-in forwards}

  #thauma-err{position:fixed;left:50%;top:48%;transform:translate(-50%,-50%);z-index:60;
    font-family:ui-monospace,monospace;font-size:13px;letter-spacing:.08em;color:var(--foam);
    opacity:0;pointer-events:none;text-align:center}
  .thauma-collapsing #thauma-err{animation:thauma-err-flash 1.8s steps(1,end) forwards .3s}
  @keyframes thauma-err-flash{
    0%,100%{opacity:0}
    15%,20%{opacity:1}
    25%{opacity:.15}
    35%,45%{opacity:1}
    55%{opacity:.1}
    65%,80%{opacity:1}
  }

  @media(prefers-reduced-motion:reduce){
    .thauma-pulse{animation:none}
    html.thauma-screen-glitch{animation:none}
    #thauma-game.shake{animation:none}
    .thauma-collapsing .thauma-char,.thauma-collapsing .thauma-shatter-piece{animation:none;opacity:0}
    .thauma-collapsing #thauma-err{animation:none;opacity:0}
  }
  {%- endif %}
</style>
</head>
<body>

{% for lang in site.languages %}
{% set t = i18n[lang] %}
<nav data-lang-block="{{ lang }}"{% if not loop.first %} hidden{% endif %}><div class="wrap nav-in">
  <a class="logo" href="/{{ lang }}/">THAUMA</a>
  <div class="links">
    <a href="/{{ lang }}/about/">{{ t.nav.about }}</a>
    <a href="/{{ lang }}/mission/">{{ t.nav.mission }}</a>
    <a href="/{{ lang }}/values/">{{ t.nav.values }}</a>
    <a href="/{{ lang }}/team/">{{ t.nav.team }}</a>
    <a href="/{{ lang }}/resources/">{{ t.nav.resources }}</a>
    <a href="/{{ lang }}/contact/">{{ t.nav.contact }}</a>
    {% if site.showEvents %}<a href="/{{ lang }}/events/">{{ t.nav.events }}</a>{% endif %}
  </div>
  <div class="nav-actions">
    {%- for l in site.languages %}{% if l != lang %}
    <button class="lang-toggle" data-lang="{{ l }}" aria-label="Switch language to {{ l }}">{{ l | upper }}</button>{% endif %}{% endfor %}
    <a class="give-btn" href="/{{ lang }}/give/">{{ t.nav.give }}</a>
  </div>
</div></nav>
{% endfor %}

<main>
{% for lang in site.languages %}
{% set t = i18n[lang] %}
<div data-lang-block="{{ lang }}"{% if not loop.first %} hidden{% endif %}>
  <div class="dict"><div class="wrap">
    <div class="cue foam">{{ t.notFound.cue }}</div>
    <div class="dict-word">{{ t.notFound.dict_word }}</div>
    <div class="dict-ipa">{{ t.notFound.dict_ipa }}</div>
    <div class="dict-defs"><p>{{ t.notFound.dict_def }}</p></div>
    <p class="lede">{{ t.notFound.lede }}</p>
    <p class="btn-row"><a class="btn solid" href="/{{ lang }}/">{{ t.notFound.cta }}</a></p>
  </div></div>
</div>
{% endfor %}
</main>

{% for lang in site.languages %}
{% set t = i18n[lang] %}
<footer data-lang-block="{{ lang }}"{% if not loop.first %} hidden{% endif %}><div class="wrap foot-in">
  <div class="foot-col">
    <div class="foot-tag">{{ t.footer.tagline }}</div>
    <div class="foot-legal">{{ t.footer.legal }}</div>
  </div>
  <div class="foot-col foot-right">
    <span class="foot-region">{{ t.footer.region }}</span>
  </div>
</div></footer>
{% endfor %}

{%- if not env.isProduction %}
<div id="thauma-err">ERR: PAGE_INTEGRITY_LOST</div>
<div id="thauma-scanlines"></div>

<div id="thauma-game">
  <canvas id="thauma-canvas"></canvas>
  <div class="thauma-track" id="thauma-track"><i id="thauma-progress"></i></div>
  <div class="thauma-hud">
    <div class="signal"><span id="thauma-signal-label">SIGNAL</span><b id="thauma-signal">0</b></div>
    <div class="signal"><span id="thauma-best-label">Best</span><b id="thauma-best">0</b></div>
  </div>

  <div class="thauma-overlay" id="thauma-home">
    <div class="panel">
      <div class="home-word" id="thauma-home-word">404</div>
      <p class="home-tag" id="thauma-home-tag">still lost.</p>
      <p class="stats" id="thauma-home-stats"></p>
      <p class="btn-row center">
        <button class="btn solid" type="button" id="thauma-play">Play</button>
      </p>
      <p class="btn-row center" style="margin-top:14px">
        <a class="btn ghost" href="/" id="thauma-home-exit">Go back to Thauma</a>
      </p>
    </div>
  </div>

  <div class="thauma-overlay" id="thauma-fail">
    <div class="panel">
      <p class="taunt" id="thauma-taunt">Page not found.</p>
      <p class="stats" id="thauma-stats"></p>
      <p class="btn-row center">
        <button class="btn solid" type="button" id="thauma-retry">Retry</button>
        <button class="btn ghost" type="button" id="thauma-fail-home">Home</button>
      </p>
    </div>
  </div>
</div>
{%- endif %}

<script>
  function setLang(lang) {
    document.querySelectorAll('[data-lang-block]').forEach(function (el) {
      el.hidden = el.dataset.langBlock !== lang;
    });
    document.documentElement.lang = lang;
    document.cookie = 'thauma_lang=' + lang + ';path=/;max-age=31536000;samesite=lax';
  }

  var initial = 'en';
  var cookieMatch = document.cookie.match(/thauma_lang=([a-z]{2})/);
  if (cookieMatch && {{ site.languages | dump | safe }}.indexOf(cookieMatch[1]) !== -1) {
    initial = cookieMatch[1];
  } else if (location.pathname.indexOf('/hr/') === 0) {
    initial = 'hr';
  }
  setLang(initial);

  document.querySelectorAll('.lang-toggle').forEach(function (btn) {
    btn.addEventListener('click', function () { setLang(btn.dataset.lang); });
  });
</script>

{%- if not env.isProduction %}
<script>
(function () {
  var LANG_DATA = {
    en: { taunts: {{ i18n.en.notFound.taunts | dump | safe }}, signal: {{ i18n.en.notFound.signal_label | dump | safe }}, best: {{ i18n.en.notFound.best_label | dump | safe }}, newBest: {{ i18n.en.notFound.new_best | dump | safe }}, homeTag: {{ i18n.en.notFound.home_tag | dump | safe }}, gameTitle: {{ i18n.en.notFound.game_title | dump | safe }}, words: {{ i18n.en.nav | dump | safe }} },
    hr: { taunts: {{ i18n.hr.notFound.taunts | dump | safe }}, signal: {{ i18n.hr.notFound.signal_label | dump | safe }}, best: {{ i18n.hr.notFound.best_label | dump | safe }}, newBest: {{ i18n.hr.notFound.new_best | dump | safe }}, homeTag: {{ i18n.hr.notFound.home_tag | dump | safe }}, gameTitle: {{ i18n.hr.notFound.game_title | dump | safe }}, words: {{ i18n.hr.nav | dump | safe }} }
  };

  var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var gameEl = document.getElementById('thauma-game');
  var canvas = document.getElementById('thauma-canvas');
  var ctx = canvas.getContext('2d');
  var homeEl = document.getElementById('thauma-home');
  var homeWordEl = document.getElementById('thauma-home-word');
  var homeTagEl = document.getElementById('thauma-home-tag');
  var homeStatsEl = document.getElementById('thauma-home-stats');
  var homeExitEl = document.getElementById('thauma-home-exit');
  var failEl = document.getElementById('thauma-fail');
  var tauntEl = document.getElementById('thauma-taunt');
  var statsEl = document.getElementById('thauma-stats');
  var signalEl = document.getElementById('thauma-signal');
  var bestEl = document.getElementById('thauma-best');
  var signalLabelEl = document.getElementById('thauma-signal-label');
  var bestLabelEl = document.getElementById('thauma-best-label');
  var progressEl = document.getElementById('thauma-progress');
  var trackEl = document.getElementById('thauma-track');
  var scanlinesEl = document.getElementById('thauma-scanlines');
  var errEl = document.getElementById('thauma-err');

  function currentLang() { return document.documentElement.lang === 'hr' ? 'hr' : 'en'; }
  function copy() { return LANG_DATA[currentLang()]; }

  function readNum(key, fallback) {
    var v = parseInt(localStorage.getItem(key), 10);
    return isNaN(v) ? fallback : v;
  }
  function readArr(key) {
    try { return JSON.parse(localStorage.getItem(key)) || []; } catch (e) { return []; }
  }

  var attempts = readNum('thauma_attempts', 0);
  var bestSignal = readNum('thauma_best', 0);
  var recentDeaths = readArr('thauma_recent_deaths');

  function statsLine() {
    var deaths = recentDeaths.length ? recentDeaths.join(', ') : '—';
    return copy().best + ': <b>' + bestSignal + '</b> &nbsp;·&nbsp; ' + copy().signal + ': ' + deaths;
  }

  // ---- Door 4: the "404" numeral ----
  document.querySelectorAll('.dict-word').forEach(function (el) {
    el.addEventListener('click', beginGame);
  });

  if (!reducedMotion) {
    setInterval(function () {
      if (gameEl.classList.contains('open')) return;
      document.querySelectorAll('.dict-word').forEach(function (el) {
        if (el.offsetParent === null) return; // its lang block is hidden
        el.classList.remove('thauma-pulse');
        void el.offsetWidth;
        el.classList.add('thauma-pulse');
      });
    }, 5000);
  }

  var began = false;
  // ---- Hash entry from doors 1-3 (arriving from any page via main.js) ----
  // These never saw the static 404 render — the "discovery" already
  // happened wherever they triggered it, so arriving here should feel
  // like teleporting straight into the game's menu, not re-running the
  // collapse on a page they're only passing through. Door 4 (below) is
  // the only path that plays the theater, since that's the one place you
  // actually watch the page fail from a standing start.
  function checkHash() { if (location.hash === '#play') enterDirectly(); }
  checkHash();
  window.addEventListener('hashchange', checkHash);

  function enterDirectly() {
    if (began) return;
    began = true;
    openGameHome();
  }

  // ---- Screen-wide glitch punch, reusable for the collapse start + death ----
  function screenGlitch() {
    if (reducedMotion) return;
    document.documentElement.classList.remove('thauma-screen-glitch');
    void document.documentElement.offsetWidth;
    document.documentElement.classList.add('thauma-screen-glitch');
    scanlinesEl.classList.add('show');
    setTimeout(function () { scanlinesEl.classList.remove('show'); }, 260);
  }

  // ---- Splits an element's text into per-character spans that scatter
  // independently (each gets its own --dx/--dy/--rot), instead of the
  // whole block fading as one uniform piece. ----
  function splitAndScatter(el) {
    var text = el.textContent;
    el.innerHTML = '';
    var n = text.length;
    text.split('').forEach(function (ch, i) {
      var span = document.createElement('span');
      span.className = 'thauma-char';
      span.textContent = ch;
      var t = n > 1 ? i / (n - 1) : 0.5;
      var dx = -90 + t * 190 + (Math.random() * 30 - 15);
      var dy = 55 + Math.random() * 70;
      var rot = -25 + t * 55 + (Math.random() * 16 - 8);
      span.style.setProperty('--dx', dx.toFixed(0) + 'px');
      span.style.setProperty('--dy', dy.toFixed(0) + 'px');
      span.style.setProperty('--rot', rot.toFixed(0) + 'deg');
      el.appendChild(span);
    });
  }

  function shatterPiece(el) {
    el.classList.add('thauma-shatter-piece');
    var dx = (Math.random() * 260 - 130).toFixed(0) + 'px';
    var dy = (30 + Math.random() * 90).toFixed(0) + 'px';
    var rot = (Math.random() * 40 - 20).toFixed(0) + 'deg';
    el.style.setProperty('--dx', dx);
    el.style.setProperty('--dy', dy);
    el.style.setProperty('--rot', rot);
    el.style.animationDelay = (Math.random() * 0.3).toFixed(2) + 's';
  }

  // ---- Begin: choreographed collapse (unless reduced motion), then the
  // game's own home screen — never straight into a run. ----
  function beginGame() {
    if (began) return;
    began = true;
    if (reducedMotion) { openGameHome(); return; }

    screenGlitch();

    document.querySelectorAll('[data-lang-block]:not([hidden])').forEach(function (block) {
      var word = block.querySelector('.dict-word');
      if (word) splitAndScatter(word);
      var pieces = block.querySelectorAll('.cue, .dict-ipa, .dict-defs p, .lede, .btn-row, .logo, .links, .nav-actions, .foot-col');
      pieces.forEach(shatterPiece);
    });

    document.body.classList.add('thauma-collapsing');
    setTimeout(function () { screenGlitch(); }, 900); // a second jolt partway through
    setTimeout(openGameHome, 2100);
  }

  // ---- The game's own home screen: stats, Play, and its own way back ----
  function openGameHome() {
    document.body.classList.remove('thauma-collapsing');
    gameEl.classList.add('open');
    homeEl.classList.add('show');
    failEl.classList.remove('show');
    homeWordEl.textContent = copy().gameTitle;
    homeTagEl.textContent = copy().homeTag;
    homeStatsEl.innerHTML = statsLine();
    homeExitEl.href = '/' + currentLang() + '/';
    signalLabelEl.textContent = copy().signal;
    bestLabelEl.textContent = copy().best;
    bestEl.textContent = bestSignal;
    resizeCanvas();
    updateTrackDom();
  }

  document.getElementById('thauma-play').addEventListener('click', function () {
    homeEl.classList.remove('show');
    startRun();
  });
  document.getElementById('thauma-fail-home').addEventListener('click', function () {
    running = false;
    failEl.classList.remove('show');
    openGameHome();
  });
  document.getElementById('thauma-retry').addEventListener('click', startRun);

  window.addEventListener('resize', resizeCanvas);
  function resizeCanvas() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }

  // ---- Flappy Light (placeholder mechanic, §7) ----
  // Tuned looser than the first pass: less gravity, a stronger flap, and
  // wider/more-spaced gaps, after the original felt too punishing to
  // actually play (verified structurally the first time, not by feel).
  var W, H, orb, columns, running, signal, speed, bestBeaten, trail, words, bestMarkerX, beatFlash;
  var GRAVITY = 0.22, FLAP = -7.8, COLUMN_W = 54, GAP_H = 260, ORB_R = 10, COLUMN_GAP = 420;

  function siteWords() {
    var w = copy().words || {};
    return Object.keys(w).map(function (k) { return w[k]; }).filter(Boolean);
  }

  function startRun() {
    W = canvas.width; H = canvas.height;
    orb = { x: Math.max(90, W * 0.22), y: H / 2, vy: 0, tilt: 0 };
    columns = [];
    trail = [];
    words = [];
    signal = 0;
    speed = 2.0;
    bestBeaten = false;
    beatFlash = 0;
    // The vertical "best" line lives in the same scrolling world as the
    // columns — it starts one best-run's-worth of distance ahead, so it
    // naturally reaches the orb exactly when this run matches the old one.
    bestMarkerX = bestSignal > 0 ? orb.x + (bestSignal / 10) * (COLUMN_W + COLUMN_GAP / 3) : null;
    failEl.classList.remove('show');
    signalEl.textContent = 0;
    spawnColumn(W + 60);
    spawnWord(W + 200);
    running = true;
    requestAnimationFrame(loop);
  }

  function spawnColumn(x) {
    var margin = 90;
    var gapY = margin + Math.random() * Math.max(40, H - margin * 2 - GAP_H) + GAP_H / 2;
    // A few noise slices per column give it texture instead of a flat fill
    var slices = [];
    for (var i = 0; i < 5; i++) slices.push(Math.random());
    columns.push({ x: x, gapY: gapY, passed: false, slices: slices });
  }

  function spawnWord(x) {
    var pool = siteWords();
    if (!pool.length) return;
    var text = pool[Math.floor(Math.random() * pool.length)];
    words.push({ x: x, y: 60 + Math.random() * Math.max(40, H - 160), text: text });
  }

  function flap() { if (running) orb.vy = FLAP; }
  canvas.addEventListener('pointerdown', flap);
  window.addEventListener('keydown', function (e) {
    if (!running) return;
    if (e.code === 'Space' || e.key === ' ') { e.preventDefault(); flap(); }
  });

  function bgColor() {
    var tier = Math.min(8, Math.floor(signal / 100));
    var t = tier / 8;
    var r = Math.round(11 + (42 - 11) * t), g = Math.round(15 + (52 - 15) * t), b = Math.round(21 + (68 - 21) * t);
    return 'rgb(' + r + ',' + g + ',' + b + ')';
  }

  function trackMax() {
    var deathsMax = recentDeaths.reduce(function (m, v) { return Math.max(m, v); }, 0);
    return Math.max(300, bestSignal * 1.15, signal * 1.15, deathsMax * 1.15);
  }

  // Each marker gets a small pulsing dot floating just above the track
  // (the ".tick-mark" child) so recent deaths and the best-run summit are
  // genuinely visible on screen during play, not just a sliver on a thin
  // line at the edge.
  function makeTick(className, leftPct, title) {
    var tick = document.createElement('span');
    tick.className = className;
    tick.style.left = leftPct + '%';
    if (title) tick.title = title;
    var dot = document.createElement('span');
    dot.className = 'tick-mark';
    tick.appendChild(dot);
    return tick;
  }

  function updateTrackDom() {
    var max = trackMax();
    progressEl.style.width = Math.min(100, ((signal || 0) / max) * 100) + '%';
    trackEl.querySelectorAll('.thauma-tick').forEach(function (t) { t.remove(); });
    if (bestSignal > 0) {
      trackEl.appendChild(makeTick('thauma-tick summit', Math.min(100, (bestSignal / max) * 100), copy().best + ': ' + bestSignal));
    }
    recentDeaths.forEach(function (v) {
      trackEl.appendChild(makeTick('thauma-tick', Math.min(100, (v / max) * 100)));
    });
  }

  function update() {
    orb.vy += GRAVITY;
    orb.y += orb.vy;
    // Tilt reads as forward motion — nose up while rising, nose down while
    // falling — the classic language for "this is moving," since otherwise
    // only the world scrolling (not the orb itself) would show speed.
    orb.tilt = Math.max(-0.5, Math.min(0.9, orb.vy * 0.07));
    trail.push({ x: orb.x, y: orb.y });
    if (trail.length > 14) trail.shift();

    for (var i = columns.length - 1; i >= 0; i--) {
      columns[i].x -= speed;
      if (!columns[i].passed && columns[i].x + COLUMN_W < orb.x - ORB_R) {
        columns[i].passed = true;
        signal += 10;
        signalEl.textContent = signal;
        if (!bestBeaten && signal > bestSignal) {
          bestBeaten = true;
          bestEl.textContent = signal;
          beatFlash = 0.001; // the moment the run overtakes its own best - authoritative on score, not the line's approximate position
        }
      }
      if (columns[i].x < -COLUMN_W - 60) columns.splice(i, 1);
    }
    if (!columns.length || columns[columns.length - 1].x < W - COLUMN_GAP) spawnColumn(W + 40);
    speed = 2.0 + Math.min(2.4, signal / 420);

    for (var k = words.length - 1; k >= 0; k--) {
      words[k].x -= speed * 0.4; // parallax: slower than the columns
      if (words[k].x < -400) words.splice(k, 1);
    }
    if (!words.length || words[words.length - 1].x < W - 500) spawnWord(W + 300 + Math.random() * 200);

    if (bestMarkerX !== null) bestMarkerX -= speed;
    if (beatFlash > 0) beatFlash = Math.min(1.6, beatFlash + 0.06);

    if (orb.y - ORB_R < 0 || orb.y + ORB_R > H) { die(); return false; }
    for (var j = 0; j < columns.length; j++) {
      var c = columns[j];
      if (orb.x + ORB_R > c.x && orb.x - ORB_R < c.x + COLUMN_W) {
        var top = c.gapY - GAP_H / 2, bottom = c.gapY + GAP_H / 2;
        if (orb.y - ORB_R < top || orb.y + ORB_R > bottom) { die(); return false; }
      }
    }
    updateTrackDom();
    return true;
  }

  function draw() {
    ctx.fillStyle = bgColor();
    ctx.fillRect(0, 0, W, H);

    // Parallax background: real site words (nav labels, both languages
    // depending which is active) drifting slower than the foreground —
    // the game reads the site's own content, per GAME-SPEC.md §2.
    ctx.save();
    ctx.font = "200 56px 'Sora',sans-serif";
    ctx.fillStyle = 'rgba(237,242,248,.07)';
    ctx.textBaseline = 'middle';
    words.forEach(function (w) { ctx.fillText(w.text, w.x, w.y); });
    ctx.restore();

    // Vertical "best" line: a techy marker scrolling in the same world as
    // the columns, positioned so it reaches the orb exactly when this run
    // matches the old best. Passing it is the moment the run gets flashy.
    if (bestMarkerX !== null && bestMarkerX > -40 && bestMarkerX < W + 40) {
      ctx.save();
      var pulse = 0.5 + Math.sin(Date.now() / 260) * 0.25;
      ctx.strokeStyle = 'rgba(92,242,196,' + (0.55 + pulse * 0.3) + ')';
      ctx.lineWidth = 2;
      ctx.shadowColor = '#5CF2C4';
      ctx.shadowBlur = 16 + pulse * 10;
      ctx.setLineDash([10, 8]);
      ctx.beginPath();
      ctx.moveTo(bestMarkerX, 0);
      ctx.lineTo(bestMarkerX, H);
      ctx.stroke();
      ctx.restore();
    }

    // Columns get a few glitch-noise slices and a bright gap-edge instead
    // of a flat fill.
    columns.forEach(function (c) {
      var top = c.gapY - GAP_H / 2, bottom = c.gapY + GAP_H / 2;
      ctx.fillStyle = 'rgba(47,216,255,.5)';
      ctx.fillRect(c.x, 0, COLUMN_W, top);
      ctx.fillRect(c.x, bottom, COLUMN_W, H - bottom);
      ctx.fillStyle = 'rgba(237,242,248,.16)';
      c.slices.forEach(function (s, i) {
        var sh = 10 + s * 16;
        var sy1 = (i / c.slices.length) * top;
        var sy2 = bottom + (i / c.slices.length) * (H - bottom);
        ctx.fillRect(c.x + s * (COLUMN_W - 10), sy1, 8, Math.min(sh, top - sy1));
        ctx.fillRect(c.x + (1 - s) * (COLUMN_W - 10), sy2, 8, Math.min(sh, H - sy2));
      });
      ctx.fillStyle = 'rgba(92,242,196,.9)';
      ctx.fillRect(c.x, top - 2, COLUMN_W, 2);
      ctx.fillRect(c.x, bottom, COLUMN_W, 2);
    });

    trail.forEach(function (p, i) {
      ctx.beginPath();
      ctx.fillStyle = 'rgba(92,242,196,' + (0.05 + (i / trail.length) * 0.25) + ')';
      ctx.arc(p.x, p.y, ORB_R * (0.3 + (i / trail.length) * 0.5), 0, Math.PI * 2);
      ctx.fill();
    });

    // The orb tilts with its own velocity (nose up rising, nose down
    // falling) and gets a short comet-tail toward where it came from, so
    // it visibly reads as the thing moving, not just the world scrolling.
    ctx.save();
    ctx.translate(orb.x, orb.y);
    ctx.rotate(orb.tilt);
    ctx.beginPath();
    ctx.fillStyle = 'rgba(47,216,255,.35)';
    ctx.ellipse(-ORB_R * 1.4, 0, ORB_R * 1.6, ORB_R * 0.55, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.beginPath();
    ctx.fillStyle = '#EDF2F8';
    ctx.shadowColor = '#2FD8FF';
    ctx.shadowBlur = 20;
    ctx.ellipse(0, 0, ORB_R * 1.05, ORB_R * 0.92, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.shadowBlur = 0;
    ctx.restore();

    if (beatFlash > 0 && beatFlash < 1.6) {
      ctx.save();
      ctx.globalAlpha = Math.max(0, 1 - beatFlash);
      ctx.fillStyle = '#5CF2C4';
      ctx.fillRect(0, 0, W, H);
      ctx.restore();
    }
  }

  function loop() {
    if (!running) return;
    if (update() === false) return;
    draw();
    requestAnimationFrame(loop);
  }

  function die() {
    running = false;
    attempts++;
    localStorage.setItem('thauma_attempts', attempts);

    recentDeaths.unshift(signal);
    recentDeaths = recentDeaths.slice(0, 3);
    localStorage.setItem('thauma_recent_deaths', JSON.stringify(recentDeaths));

    var newBest = signal > bestSignal;
    if (newBest) {
      bestSignal = signal;
      localStorage.setItem('thauma_best', bestSignal);
    }
    updateTrackDom();
    screenGlitch();
    gameEl.classList.remove('shake');
    void gameEl.offsetWidth;
    gameEl.classList.add('shake');

    var taunts = copy().taunts;
    var idx = Math.min(attempts, taunts.length) - 1;
    tauntEl.textContent = (newBest ? copy().newBest + ' ' : '') + taunts[idx];
    statsEl.innerHTML = copy().signal + ': <b>' + signal + '</b> &nbsp;·&nbsp; ' + copy().best + ': <b>' + bestSignal + '</b>';
    failEl.classList.add('show');
  }
})();
</script>
{%- endif %}
</body>
</html>
