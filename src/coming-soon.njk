---
pagination:
  data: activeLangs
  size: 1
  alias: lang
isComingSoonPage: true
---
{% set t = i18n[lang] %}
{% from "partials/lang-dropdown.njk" import langDropdown with context %}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Thauma</title>
<meta name="description" content="{{ t.coming.text | plain }}">
<meta name="robots" content="noindex">
<link rel="preload" as="font" type="font/woff2" href="/fonts/Sora-latin-v2.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/fonts/Inter-latin-v2.woff2" crossorigin>
{% include "brand-head.njk" %}
<link rel="stylesheet" href="/css/main.css?v={{ "/css/main.css" | v }}">
<style>
  /* THE LANDING, "B" ON THE CANVAS (Chase, 2026-10-14/15): the logo in
     pieces (brand/logo-split.njk) assembles as the page opens; the words
     keep their left edge, but the block they make sits on the page's center
     line; Serve, Train and Resource stand beside the words. Each part
     arrives after the one before. Then, on repeat, the logo's short closing
     line slowly shortens and returns — the work going on. All of it still
     for a visitor who asked for less motion. */
  body { min-height: 100vh; min-height: 100svh; display: flex; flex-direction: column; }
  .lp-top { display: flex; justify-content: flex-end; padding: 24px 6%; }
  .landing { flex: 1; display: flex; align-items: center; justify-content: center; padding: 24px 6% 64px; }
  .lp { width: min(84vw, 1040px); display: flex; flex-direction: column; align-items: center; }
  .landing .lp-logo { width: 100%; font-size: 0; line-height: 0; letter-spacing: 0; color: var(--text); }
  .brand-logo-split { display: block; width: 100%; height: auto; overflow: visible; }
  .brand-logo-split .lg-ch, .brand-logo-split .lg-line { transform-box: fill-box; }
  .brand-logo-split .lg-line { transform-origin: left center; }
  .lp-block { width: 100%; max-width: 940px; margin-top: clamp(40px, 7vh, 64px); text-align: left; }
  .lp-block .cue { margin: 0; }
  .lp-row { display: flex; flex-wrap: wrap; gap: 32px 64px; margin-top: 22px; }
  .lp-text { flex: 1 1 360px; max-width: 520px; }
  .lp-text .hero-line { margin: 0; text-align: left; }
  .lp-text .hero-sub { margin: 20px 0 0; text-align: left; max-width: none; }
  .lp-pillars { flex: 1 1 300px; align-self: end; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .lp-pillars div { display: flex; flex-direction: column; gap: 8px; }
  .lp-rule { display: block; height: 1px; margin-bottom: 8px; background: rgba(255,255,255,.14); transform-origin: left center; }
  .lp-pillars b { font: 600 13px/1.3 'Sora', sans-serif; color: var(--text); }
  .lp-pillars span:not(.lp-rule) { font-size: 13px; line-height: 1.6; color: var(--dim); }
  @media (max-width: 560px) { .lp-pillars { grid-template-columns: 1fr; } }

  @keyframes lp-ch { from { opacity: 0; transform: translateY(18%); } to { opacity: 1; transform: none; } }
  @keyframes lp-line { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes lp-rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes lp-work { 0%, 12% { transform: scaleX(1); } 50% { transform: scaleX(.3); } 88%, 100% { transform: scaleX(1); } }
  @media (prefers-reduced-motion: no-preference) {
    .lg-ch { animation: lp-ch .75s cubic-bezier(.55,.05,.45,.95) both; animation-delay: calc(var(--i) * 90ms + 250ms); }
    .lg-arrive { animation: lp-line 1.1s cubic-bezier(.16,1,.3,1) 1.05s both; }
    .lg-bar { animation: lp-line .5s cubic-bezier(.55,.05,.45,.95) 1.75s both; }
    .lg-close1 { animation: lp-line .7s cubic-bezier(.16,1,.3,1) 2.15s both; }
    .lg-close2 { animation: lp-line .7s cubic-bezier(.16,1,.3,1) 2.3s both, lp-work 4.2s cubic-bezier(.55,.05,.45,.95) 3.6s infinite; }
    .lp-in { animation: lp-rise .9s cubic-bezier(.16,1,.3,1) both; }
    .lp-rule { animation: lp-line .8s cubic-bezier(.16,1,.3,1) both; }
    .lp-1 { animation-delay: 2.35s; } .lp-2 { animation-delay: 2.5s; } .lp-3 { animation-delay: 2.65s; }
    .lp-4 { animation-delay: 2.85s; } .lp-5 { animation-delay: 3s; } .lp-6 { animation-delay: 3.15s; }
    .lp-rule.lp-4 { animation-delay: 2.75s; } .lp-rule.lp-5 { animation-delay: 2.9s; } .lp-rule.lp-6 { animation-delay: 3.05s; }
    .lp-top { animation: lp-rise .9s cubic-bezier(.16,1,.3,1) .1s both; }
  }
</style>
</head>
<body>
<header class="lp-top">{{ langDropdown() }}</header>
<main class="landing">
  <div class="lp">
    {#- .wordmark: the arcade's five-tap door (see arcade-doors.njk) -#}
    <div class="wordmark lp-logo">{% set logoId = "land" %}{% include "brand/logo-split.njk" %}</div>
    <div class="lp-block">
      <div class="cue bare lp-in lp-1">{{ t.home.cue | rich("home.cue") }}</div>
      <div class="lp-row">
        <div class="lp-text">
          <p class="hero-line lp-in lp-2">{{ t.coming.line_thin | rich("coming.line_thin") }} <b>{{ t.coming.line_bold | rich("coming.line_bold") }}</b></p>
          <p class="hero-sub lp-in lp-3">{{ t.coming.text | rich("coming.text") }}</p>
        </div>
        <div class="lp-pillars">
          {%- for k in ["serve", "train", "resource"] %}
          <div><span class="lp-rule lp-{{ loop.index + 3 }}"></span><b class="lp-in lp-{{ loop.index + 3 }}">{{ t.coming[k] | rich("coming." + k) }}</b><span class="lp-in lp-{{ loop.index + 3 }}">{{ t.coming[k + "_text"] | rich("coming." + k + "_text") }}</span></div>
          {%- endfor %}
        </div>
      </div>
    </div>
  </div>
</main>
<script src="/js/main.js?v={{ "/js/main.js" | v }}"></script>
{% include "arcade-doors.njk" %}
</body>
</html>
