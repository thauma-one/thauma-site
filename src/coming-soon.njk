---
pagination:
  data: activeLangs
  size: 1
  alias: lang
isComingSoonPage: true
---
{% set t = i18n[lang] %}
{% from "partials/lang-dropdown.njk" import langDropdown with context %}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Thauma</title>
<meta name="description" content="{{ t.coming.text | plain }}">
<meta name="robots" content="noindex">
<link rel="preload" as="font" type="font/woff2" href="/fonts/Sora-latin-v2.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/fonts/Inter-latin-v2.woff2" crossorigin>
{% include "brand-head.njk" %}
<link rel="stylesheet" href="/css/main.css?v={{ "/css/main.css" | v }}">
<style>
  /* THE LANDING = THE CLOSED PAGE + THE LANDING'S WORDS (Chase, 2026-10-16:
     "this animation, both of the Thauma logo and the background and the
     cascading phrase, should be incorporated into the landing page … the
     other words on the landing page should still be there underneath it.
     All of the content should be centered … the 'Serve, Train, Resource'
     text should be colored so they stand out more"). The logo assembles and
     shimmers; the two glows drift in the corners; the footer line cycles
     through every published language, cascading down; then the cue, the
     words and the three pillars arrive one by one, all on the center line.
     Reduced motion: all still. 2026-10-28 (Chase): the closing lines no
     longer "breathe"; the shimmer and the cascade are slower; everything
     else arrives in about half the time ("It took forever for all of the
     information to show up"). workers/src/site/serve.js closedSite is the same page without
     the words. */
  html,body{overflow-x:hidden}
  body { min-height: 100vh; min-height: 100svh; display: flex; flex-direction: column; }
  .cs-glow{position:fixed;inset:-25%;pointer-events:none;z-index:-1}
  .cs-glow::before,.cs-glow::after{content:"";position:absolute;inset:0}
  .cs-glow::before{background:radial-gradient(34% 30% at 22% 20%,rgba(47,216,255,.30),transparent 70%);animation:cs-a 24s ease-in-out infinite alternate}
  .cs-glow::after{background:radial-gradient(32% 30% at 80% 82%,rgba(92,242,196,.22),transparent 70%);animation:cs-b 31s ease-in-out infinite alternate}
  @keyframes cs-a{0%{transform:translate(0,0)}50%{transform:translate(-4%,5%) scale(1.08)}100%{transform:translate(5%,-3%)}}
  @keyframes cs-b{0%{transform:scale(1.06)}50%{transform:translate(4%,-4%)}100%{transform:translate(-5%,3%) scale(1)}}
  .lp-top { display: flex; justify-content: flex-end; padding: 24px 6%; }
  .landing { flex: 1; display: flex; align-items: center; justify-content: center; padding: 24px 6% 72px; }
  .lp { width: min(92vw, 1180px); display: flex; flex-direction: column; align-items: center; text-align: center; }
  .landing .lp-logo { position: relative; width: 100%; font-size: 0; line-height: 0; letter-spacing: 0; color: var(--text); }
  .cs-line { display: grid; margin-top: 36px; height: 34px; overflow: hidden; font: 100 22px/34px 'Sora', sans-serif; letter-spacing: .06em; color: var(--text); }
  .cs-line > span { grid-area: 1 / 1; display: flex; justify-content: center; }
  .cs-ch { display: inline-block; white-space: pre; font-kerning: none; animation-duration: 1.6s; animation-timing-function: cubic-bezier(.55,.05,.45,.95); animation-fill-mode: both; }
  .cs-in .cs-ch { animation-name: cs-in; } .cs-out .cs-ch { animation-name: cs-out; }
  @keyframes cs-in { from { transform: translateY(-105%); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes cs-out { from { transform: none; opacity: 1; } to { transform: translateY(105%); opacity: 0; } }
  /* THE WORDS AND THE PILLARS SIDE BY SIDE, the pair centered on the page
     (Chase, 2026-10-19: "I also want the Serve, Train, Resource things to
     still be to the right of the In Preparation section"); stacked and
     centered on a narrow screen */
  .lp-block { width: 100%; max-width: 1000px; margin-top: clamp(48px, 8vh, 80px); display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 32px 64px; align-items: end; text-align: left; }
  .lp-block .cue { margin: 0; }
  .lp-block .hero-line { margin: 22px 0 0; text-align: left; }
  .lp-block .hero-sub { margin: 18px 0 0; text-align: left; max-width: 34rem; }
  .lp-pillars { width: 100%; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .lp-pillars div { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .lp-rule { display: block; width: 100%; height: 1px; margin-bottom: 8px; background: linear-gradient(90deg, var(--foam-dim), transparent); }
  @media (max-width: 820px) {
    .lp-block { grid-template-columns: 1fr; text-align: center; }
    .lp-block .hero-line, .lp-block .hero-sub { text-align: center; margin-left: auto; margin-right: auto; }
    .lp-block .cue::after { content: "" !important; display: inline-block !important; width: 34px; height: 1px; background: currentColor; margin-left: 14px; vertical-align: middle; }
    .lp-pillars div { align-items: center; }
    .lp-rule { background: linear-gradient(90deg, transparent, var(--foam-dim), transparent); }
  }
  .lp-pillars b { font: 600 15px/1.3 'Sora', sans-serif; letter-spacing: .06em; color: var(--foam); text-shadow: 0 0 18px rgba(92,242,196,.35); }
  .lp-pillars > div > span:not(.lp-rule) { font-size: 13px; line-height: 1.6; color: var(--dim); }
  @media (max-width: 560px) { .lp-pillars { grid-template-columns: 1fr; gap: 20px; } .cs-line { font-size: 18px; } }
  @keyframes lg-lead{from{clip-path:inset(0 100% 0 0)}to{clip-path:inset(0 0 0 0)}}
  .arc-breaking .brand-logo-sheen { display: none; }

  @keyframes lp-ch { from { opacity: 0; transform: translateY(18%); } to { opacity: 1; transform: none; } }
  @keyframes lp-line { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes lp-rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: no-preference) {
    .lg-ch { animation: lp-ch .65s cubic-bezier(.55,.05,.45,.95) both; animation-delay: calc(var(--i) * 70ms + 120ms); }
    /* the arriving line and the H's bar: ONE stroke, with the letters */
    .lg-lead { animation: lg-lead .8s cubic-bezier(.25,.7,.35,1) .05s both; }
    .lg-close1 { animation: lp-line .6s cubic-bezier(.16,1,.3,1) .85s both; }
    .lg-close2 { animation: lp-line .6s cubic-bezier(.16,1,.3,1) .95s both; }
    .lp-in { animation: lp-rise .9s cubic-bezier(.16,1,.3,1) both; }
    .lp-rule { animation: lp-line .8s cubic-bezier(.16,1,.3,1) both; }
    .lp-1 { animation-delay: 1.1s; } .lp-2 { animation-delay: 1.2s; } .lp-3 { animation-delay: 1.3s; }
    .lp-4 { animation-delay: 1.4s; } .lp-5 { animation-delay: 1.5s; } .lp-6 { animation-delay: 1.6s; }
    .lp-rule.lp-4 { animation-delay: 1.35s; } .lp-rule.lp-5 { animation-delay: 1.45s; } .lp-rule.lp-6 { animation-delay: 1.55s; }
    .lp-top { animation: lp-rise .9s cubic-bezier(.16,1,.3,1) .05s both; }
  }
  @media (prefers-reduced-motion: reduce) { .cs-glow::before, .cs-glow::after { animation: none; } .brand-logo-sheen { display: none; } .cs-ch { animation: none !important; } }
</style>
</head>
<body>
<div class="cs-glow" aria-hidden="true"></div>
<header class="lp-top">{{ langDropdown() }}</header>
<main class="landing">
  <div class="lp">
    {#- .wordmark: the arcade's five-tap door (see arcade-doors.njk) -#}
    <div class="wordmark lp-logo">{% set logoId = "land" %}{% include "brand/logo-split.njk" %}{% include "brand/logo-sheen.njk" %}</div>
    <div class="cs-line" data-cascade aria-label="{{ t.footer.tagline | plain }}"><span class="cs-out" aria-hidden="true"></span><span class="cs-in" aria-hidden="true"></span></div>
    <div class="lp-block">
      <div class="lp-text">
        <div class="cue lp-in lp-1">{{ t.home.cue | rich("home.cue") }}</div>
        <p class="hero-line lp-in lp-2">{{ t.coming.line_thin | rich("coming.line_thin") }} <b>{{ t.coming.line_bold | rich("coming.line_bold") }}</b></p>
        <p class="hero-sub lp-in lp-3">{{ t.coming.text | rich("coming.text") }}</p>
      </div>
      <div class="lp-pillars">
        {%- for k in ["serve", "train", "resource"] %}
        <div><span class="lp-rule lp-{{ loop.index + 3 }}"></span><b class="lp-in lp-{{ loop.index + 3 }}">{{ t.coming[k] | rich("coming." + k) }}</b><span class="lp-in lp-{{ loop.index + 3 }}">{{ t.coming[k + "_text"] | rich("coming." + k + "_text") }}</span></div>
        {%- endfor %}
      </div>
    </div>
  </div>
</main>
<script>
/* the line in every published language (activeLangs), this page's first;
   js/logo-conductor.js runs it with the shimmer, on one clock */
window.THAUMA_LINES = { start: 1300, lines: (function () {
  var all = [{% for l in activeLangs %}{{ (i18n[l].footer.tagline or i18n.en.footer.tagline) | plain | dump | safe }}{% if not loop.last %},{% endif %}{% endfor %}];
  var at = Math.max(0, {{ activeLangs | dump | safe }}.indexOf({{ lang | dump | safe }}));
  return all.slice(at).concat(all.slice(0, at));
})() };
</script>
<script src="/js/logo-conductor.js?v={{ "/js/logo-conductor.js" | v }}"></script>
<script src="/js/main.js?v={{ "/js/main.js" | v }}"></script>
{% include "arcade-doors.njk" %}
</body>
</html>
