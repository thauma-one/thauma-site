{% set t = i18n[lang] %}
{% set pageName = title or (t[pageTitle].title if pageTitle else t.home.title) %}
{% set fullTitle = "Thauma | " ~ pageName %}
{% set shareImage = site.url ~ "/img/og-default.png" %}

{#- Shared language dropdown (2026-07-17, unified 2026-07-19) — ONE
   component, rendered ONCE in nav-actions, next to Give, visible at every
   width (previously had a second copy inside the mobile hamburger panel;
   now that it's a single compact trigger rather than one button per
   language, it fits in the primary bar on mobile too, same as desktop —
   no need for two copies + a breakpoint switch between them). The actual
   language-switch itself (langSwap + cookie + navigate) is untouched —
   still main.js's existing .lang-toggle click handler; this macro only
   adds the open/closed list UI around it. #}
{% macro langDropdown() %}
<div class="lang-dropdown">
  <button type="button" class="lang-dropdown-trigger" aria-haspopup="listbox" aria-expanded="false">{{ lang | upper }}</button>
  <ul class="lang-dropdown-list" role="listbox">
    {%- for l in site.languages %}
    <li role="option" aria-selected="{{ 'true' if l == lang else 'false' }}">
      {%- if l == lang %}
      <span class="lang-dropdown-current">{{ l | upper }}</span>
      {%- else %}
      <button type="button" class="lang-toggle" data-lang="{{ l }}" data-target="{{ page.url | langSwap(l) }}" aria-label="Switch language to {{ l }}">{{ l | upper }}</button>
      {%- endif %}
    </li>
    {%- endfor %}
  </ul>
</div>
{% endmacro %}

{#- Mobile page-location indicator (2026-07-19) — small numbered/labeled
   text under the logo in the nav itself (see .logo-page in main.css),
   replacing the earlier watermark. navPages (src/_data/navPages.js) is
   the nav's own order; a page not in that list (home, team bios, staff)
   simply doesn't match and nothing renders under the logo. #}
{% set navPageNum = navPages.indexOf(pageSlug) + 1 %}

<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ fullTitle }}</title>
<meta name="description" content="{{ t.home.sub }}">
{%- for l in site.languages %}{% if l != lang %}
<link rel="alternate" hreflang="{{ l }}" href="{{ site.url }}{{ page.url | langSwap(l) }}">{% endif %}{% endfor %}
<link rel="preload" as="font" type="font/woff2" href="/fonts/Sora-latin-v2.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/fonts/Inter-latin-v2.woff2" crossorigin>
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ fullTitle }}">
<meta property="og:description" content="{{ t.home.sub }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ shareImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Thauma">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ fullTitle }}">
<meta name="twitter:description" content="{{ t.home.sub }}">
<meta name="twitter:image" content="{{ shareImage }}">
<link rel="stylesheet" href="/css/main.css?v=18">
</head>
<body>

<nav><div class="wrap nav-in">
  <a class="logo" href="/{{ lang }}/">
    <span class="logo-word"><!-- <img src="/img/logo.svg" alt=""> -->THAUMA</span>
    {%- if navPageNum > 0 %}<span class="logo-page">{{ "0" if navPageNum < 10 else "" }}{{ navPageNum }} {{ t.nav[pageSlug] }}</span>{% endif %}
  </a>
  <div class="links">
    <a href="/{{ lang }}/about/">{{ t.nav.about }}</a>
    <a href="/{{ lang }}/mission/">{{ t.nav.mission }}</a>
    <a href="/{{ lang }}/values/">{{ t.nav.values }}</a>
    <a href="/{{ lang }}/team/">{{ t.nav.team }}</a>
    <a href="/{{ lang }}/resources/">{{ t.nav.resources }}</a>
    <a href="/{{ lang }}/contact/">{{ t.nav.contact }}</a>
    {% if site.showEvents %}<a href="/{{ lang }}/events/">{{ t.nav.events }}</a>{% endif %}
  </div>
  <div class="nav-actions">
    {{ langDropdown() }}
    <a class="give-btn" href="/{{ lang }}/give/">{{ t.nav.give }}</a>
  </div>
  <button class="menu-btn" aria-label="Menu"><span></span><span></span></button>
</div></nav>

{#- Full page nav, mobile only — looped from navPages (src/_data/navPages.js)
   instead of a hand-copied list, so it can never drift out of sync with the
   desktop .links above again (this list was previously missing "Team"). The
   language dropdown lives in the primary nav bar above (visible at every
   width), not duplicated in here. #}
<div class="mobile-menu">
  {%- for slug in navPages %}{% if slug != "give" %}
  <a href="/{{ lang }}/{{ slug }}/">{{ t.nav[slug] }}</a>
  {%- endif %}{% endfor %}
  <a href="/{{ lang }}/give/">{{ t.nav.give }}</a>
</div>

<main>
{{ content | safe }}
</main>

<footer><div class="wrap foot-in">
  <div class="foot-col">
    <div class="foot-tag">{{ t.footer.tagline }}</div>
    <div class="foot-legal">{{ t.footer.legal }}</div>
  </div>
  <div class="foot-col foot-right">
    {%- set hasSocials = site.socials.youtube or site.socials.instagram or site.socials.facebook or site.socials.x %}
    {%- if hasSocials %}<div class="foot-socials">
    {%- if site.socials.youtube %}<a href="{{ site.socials.youtube }}" aria-label="YouTube" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M23 7.2s-.2-1.6-.9-2.3c-.9-.9-1.9-.9-2.3-1C16.6 3.6 12 3.6 12 3.6s-4.6 0-7.8.3c-.4.1-1.4.1-2.3 1-.7.7-.9 2.3-.9 2.3S.8 9.1.8 11v1.8c0 1.9.2 3.8.2 3.8s.2 1.6.9 2.3c.9.9 2 .9 2.5 1 1.8.2 7.6.3 7.6.3s4.6 0 7.8-.4c.4-.1 1.4-.1 2.3-1 .7-.7.9-2.3.9-2.3s.2-1.9.2-3.8V11c0-1.9-.2-3.8-.2-3.8zM9.9 15V8.5l6.1 3.3-6.1 3.2z"/></svg></a>{% endif %}
    {%- if site.socials.instagram %}<a href="{{ site.socials.instagram }}" aria-label="Instagram" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none"/></svg></a>{% endif %}
    {%- if site.socials.facebook %}<a href="{{ site.socials.facebook }}" aria-label="Facebook" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.3-1.5 1.6-1.5h1.6V3.6c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4.1v2.3H7.6V13h2.7v8h3.2z"/></svg></a>{% endif %}
    {%- if site.socials.x %}<a href="{{ site.socials.x }}" aria-label="X" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M17.7 3h3l-6.6 7.5L22 21h-6.1l-4.8-6.2L5.6 21h-3l7-8L2.5 3h6.2l4.3 5.7L17.7 3zm-1 16.2h1.7L7.8 4.7H6L16.7 19.2z"/></svg></a>{% endif %}
    </div>{% endif %}
    <span class="foot-region">{{ t.footer.region }}</span>
  </div>
</div></footer>

<script>window.THAUMA_ENV = { isProduction: {{ env.isProduction | dump | safe }} };</script>
{%- if not env.isProduction %}
<script>window.THAUMA_TAUNTS = { en: {{ i18n.en.notFound.taunts | dump | safe }}, hr: {{ i18n.hr.notFound.taunts | dump | safe }} };</script>
{%- endif %}
<script src="/js/main.js?v=3"></script>
</body>
</html>
