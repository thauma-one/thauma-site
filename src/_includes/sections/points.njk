{#- POINTS, NUMBERED I, II, III (sectionKinds.js points; Home's values): the
    line above, the heading, a title and a sentence for each, and a button
    under them if it has one. -#}
{%- set wd = sec.words %}{% set look = sec.look or {} %}
{%- set roman = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII"] %}
<section{% if look.ground == "raised" %} class="alt"{% endif %}><div class="wrap">
  {%- if wd.cue %}
  <div class="cue{% if look.voice == "ministry" %} foam{% endif %}">{{ t | w(wd.cue) | rich(wd.cue) }}</div>
  {%- endif %}
  {%- if wd.heading %}
  <h2>{{ t | w(wd.heading ~ "_thin") | rich(wd.heading ~ "_thin") }} <b>{{ t | w(wd.heading ~ "_bold") | rich(wd.heading ~ "_bold") }}</b></h2>
  {%- endif %}
  <div class="vals">
    {%- for it in sec.items %}
    <div class="val"><div class="n">{{ roman[loop.index0] }}</div><h3>{{ t | w(it.title) | rich(it.title) }}</h3><p>{{ t | w(it.text) | rich(it.text) }}</p></div>
    {%- endfor %}
  </div>
  {%- if sec.buttons and sec.buttons.length %}
  <div class="btn-row">
    {%- for b in sec.buttons %}
    <a class="btn {{ b.style or "ghost" }}" href="{{ b.to | sectionHref(lang) }}">{{ t | w(b.label) | rich(b.label) }}</a>
    {%- endfor %}
  </div>
  {%- endif %}
</div></section>
