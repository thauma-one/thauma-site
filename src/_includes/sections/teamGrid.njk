{#- THE TEAM (Team): every person's card, from src/content/team; each opens
    its bio, the photo morphing into the portrait (data-vt-person, main.js).
    Fixed to Team: the people are edited in People, not here. -#}
<section><div class="wrap">
  <div class="team-grid">
    {% for person in team %}
    <a class="person" href="/{{ lang }}/team/{{ person.slug }}/">
      <div class="person-photo" data-vt-person="{{ person.slug }}">
        {% if person.photo %}<img src="{{ person.photo }}" alt="{{ person.name }}" loading="lazy" decoding="async">
        {% else %}<span class="person-initial">{{ person.name | first }}</span>{% endif %}
      </div>
      <h3>{{ person.name }}</h3>
      <div class="person-role">{{ person.role[lang] }}</div>
      <div class="person-base">{{ t.team.base_label | rich("team.base_label") }}: {{ person.base }}</div>
    </a>
    {% endfor %}
  </div>
</div></section>
