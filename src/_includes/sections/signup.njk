{#- STAY CONNECTED, AS A SECTION (from the staff Site Creator's Sign-Up,
    2026-10-27): the line above, a heading, a sentence, and a button that
    opens the site's own sign-up window — the footer's, one form for the
    whole site (main.js, [data-stay-open]). -#}
{%- set wd = sec.words %}{% set look = sec.look or {} %}
<section class="tsignup{% if look.ground == "raised" %} alt{% endif %}"><div class="wrap">
  {%- if wd.cue %}
  <div class="cue{% if look.voice == "ministry" %} foam{% endif %}">{{ t | w(wd.cue) | rich(wd.cue) }}</div>
  {%- endif %}
  <h2>{{ t | w(wd.heading ~ "_thin") | rich(wd.heading ~ "_thin") }} <b>{{ t | w(wd.heading ~ "_bold") | rich(wd.heading ~ "_bold") }}</b></h2>
  {%- if wd.lede %}
  <p class="lede">{{ t | w(wd.lede) | rich(wd.lede) }}</p>
  {%- endif %}
  <div class="btn-row"><button type="button" class="btn solid" data-stay-open>{{ t | w(wd.button) | rich(wd.button) }}</button></div>
</div></section>
