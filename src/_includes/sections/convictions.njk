{#- THE CONVICTIONS (Values): the list in the words file's own
    `values.items`, numbered 01, 02, … Fixed to Values: the list is one
    value in each language file, written on that page's lines. -#}
<section><div class="wrap">
  {% for v in t.values["items"] %}
  <div class="conviction">
    <div class="num">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</div>
    <div><h3>{{ v.title }}</h3><p>{{ v.text }}</p></div>
  </div>
  {% endfor %}
</div></section>
