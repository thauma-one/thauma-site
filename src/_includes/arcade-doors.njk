{#- THE ARCADE'S WAYS IN (ARCADE-SPEC.md) — on every page that has a door:
   the site's pages, the landing page and the 404. Nothing at all is sent
   while the arcade is switched off (site.json › visibility.sections.arcade,
   Website › Settings): until then no page loads or links
   it, and /arcade/ is not built (the scripts are copied, and sit unread).
   The versions are content hashes (the `v` filter), so a changed file is
   fetched fresh; the engine and the arcade load only when someone reaches
   for them. -#}
{%- if visible.sections.arcade %}
<script>window.THAUMA_ARCADE = { v: {
  doors: "{{ '/js/arcade/doors.js' | v }}", fail: "{{ '/js/arcade/fail.js' | v }}",
  arcade: "{{ '/js/arcade/arcade.js' | v }}", css: "{{ '/css/arcade.css' | v }}",
  play: "{{ '/js/arcade/play.js' | v }}", sound: "{{ '/js/arcade/sound.js' | v }}",
  games: {
    {%- for gid in ['loadout', 'soundcheck', 'panelfixer', 'cablerun', 'stagerunner', 'goldenhour', 'followspot', 'strike', 'cuestack'] %}
    {{ gid }}: "{{ ('/js/arcade/games/' + gid + '.js') | v }}",
    {%- endfor %} },
  vendor: { planck: "1.5.0" },
  words: "{{ '/_data/i18n/en.json' | v }}{{ '/_data/i18n/hr.json' | v }}{{ '/_data/i18n/sr.json' | v }}{{ '/_data/i18n/sl.json' | v }}" } };</script>
{#- The footer's quiet door (Chase, 2026-10-04: "a subtle icon in the
   footer's corner"): a joystick outline, barely there until hovered. -#}
<template id="arc-icon-tpl"><button type="button" class="arc-icon" aria-label="{{ (t.arcade and t.arcade.title) or 'Arcade' }}"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M5 18h14l-1.5-4h-11z"/><path d="M12 14V7"/><circle cx="12" cy="5.5" r="2.5"/><circle cx="16.5" cy="16" r=".6" fill="currentColor"/></svg></button></template>
<script src="/js/arcade/doors.js?v={{ '/js/arcade/doors.js' | v }}" defer></script>
{%- endif %}
