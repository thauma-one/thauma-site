{#- WHOSE LISTS: the ministry's or Thauma's (board 10: a small switch beside
   the page title). It changes what everything below means. Rendered only
   when the API says this account may reach the organization's lists. -#}
<div class="ml-whose" id="mlScope" hidden>
  <div class="ml-whose-opts" role="group" data-i18n-attr="aria-label:ml.scope" aria-label="Whose lists">
    <button type="button" class="ml-whose-opt is-on" data-scope="partner" id="mlScopeMine"></button>
    <button type="button" class="ml-whose-opt" data-scope="organization" data-i18n="ml.scopeOrg">Thauma</button>
  </div>
</div>
