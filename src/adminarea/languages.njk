---
layout: layouts/admin.njk
adminPage: languages
adminNum: "07"
adminTitle: Languages
adminHeading: The site in every <b>language</b>
adminScript: /js/admin-languages.js
permalink: /admin/languages/index.html
---
{#- EVERYTHING ABOUT THE SITE'S LANGUAGES THAT IS NOT THE WORDS THEMSELVES.
   Content is where a line is written; this is where a language is looked
   after: what is still untranslated, getting translations in and out, and how
   each language should read. Part 5 of the language work adds the switches,
   adding and removing a language, and the donation link.

   ONE LANGUAGE PICKER FOR THE WHOLE PAGE, a select rather than tabs or
   chips, because it has to stay usable at thirty languages. English is not
   in it: English is what everything is translated from. -#}
<p class="rolegate" id="lnProblem" hidden></p>

<div class="ln" id="lnRoot" hidden>
  <label class="ln-langpick">
    <span class="ln-h" data-i18n="ln.language">Language</span>
    <select id="lnLang"></select>
  </label>

  {#- TRANSLATE. The route Claude translates the site through, for free:
     download the file, have it filled in, bring it back, approve each line.
     Nothing is saved until it is approved, and approving saves the way
     Content does — quietly, until Publish. -#}
  <section class="ln-sec" aria-labelledby="tlTitle">
    <h2 class="ln-h" id="tlTitle" data-i18n="tl.title">Translate</h2>

    <div id="tlPick">
      <ul class="tl-groups" id="tlGroups"></ul>
      <label class="tl-finished">
        <input type="checkbox" id="tlFinished">
        <span data-i18n="tl.finished">Include finished translations</span>
      </label>
      <p class="ln-acts">
        <button type="button" class="solid-btn" id="tlDownload" disabled>Download file</button>
        <button type="button" class="ghost-btn" id="tlUpload" data-i18n="tl.upload">Upload translation</button>
        <input type="file" id="tlFile" accept=".csv,text/csv" hidden
               aria-label="Upload translation" data-i18n-attr="aria-label:tl.upload">
      </p>
    </div>

    {#- THE APPROVAL. Every returned line, English above it, what the language
       says now, and the new text — editable, because a small fix is quicker
       than another round trip. Lines the checks flag start unticked. -#}
    <div id="tlReview" hidden>
      <div class="tl-bar">
        <span class="tl-count" id="tlReviewCount" role="status"></span>
        <button type="button" class="ghost-btn" id="tlCancel" data-i18n="common.cancel">Cancel</button>
        <button type="button" class="solid-btn" id="tlApprove"></button>
      </div>
      <div class="tl-items" id="tlItems"></div>
    </div>
  </section>

  {#- WHAT EVERY TRANSLATOR READS, AI or human (0035). The file above carries
     all of it, and so will the auto-translate button. Saves at once, like
     Settings: none of it is public, so there is nothing to publish. -#}
  <section class="ln-sec" aria-labelledby="lnWritten">
    <h2 class="ln-h" id="lnWritten" data-i18n="ln.written">How each language is written</h2>

    <h3 class="ln-h3" data-i18n="ln.keep">Never translated</h3>
    <ul class="ln-chips" id="lnKeep"></ul>
    <form class="ln-add" id="lnKeepAdd" data-write>
      <input type="text" id="lnKeepTerm" maxlength="80" autocomplete="off"
             placeholder="Add a word or name" aria-label="Add a word or name"
             data-i18n-attr="placeholder:ln.keepAdd,aria-label:ln.keepAdd">
      <button type="submit" class="ghost-btn" data-i18n="ln.add">Add</button>
    </form>

    {#- Two guides: the one every language shares, and the picked language's
       own. Each saves on its own, because they are written at different
       times by different people. -#}
    <div class="ln-guide" data-guide="*">
      <label class="fld">
        <span data-i18n="ln.every">Every language</span>
        <textarea rows="4" maxlength="2000"></textarea>
      </label>
      <p class="ln-acts" data-write>
        <button type="button" class="ghost-btn" data-save disabled data-i18n="ln.saveGuide">Save guide</button>
        <span class="hint" data-status role="status"></span>
      </p>
    </div>

    <div class="ln-guide" data-guide="">
      <label class="fld">
        <span data-name></span>
        <textarea rows="4" maxlength="2000"></textarea>
      </label>
      <p class="ln-acts" data-write>
        <button type="button" class="ghost-btn" data-save disabled data-i18n="ln.saveGuide">Save guide</button>
        <span class="hint" data-status role="status"></span>
      </p>
    </div>

    {#- Fixed phrases belong to ONE language — the one picked at the top. -#}
    <div id="lnGlossWrap">
      <h3 class="ln-h3" data-i18n="ln.fixed">Fixed phrases</h3>
      <table class="ln-table">
        <thead><tr>
          <th scope="col" data-i18n="ln.english">English</th>
          <th scope="col" id="lnTargetHead"></th>
          <th scope="col"><span class="visually-hidden" data-i18n="ln.remove">Remove</span></th>
        </tr></thead>
        <tbody id="lnGlossary"></tbody>
      </table>
      <form class="ln-add ln-add-pair" id="lnGlossAdd" data-write>
        <input type="text" id="lnSource" maxlength="300" autocomplete="off"
               placeholder="English phrase" aria-label="English phrase"
               data-i18n-attr="placeholder:ln.source,aria-label:ln.source">
        <input type="text" id="lnTarget" maxlength="300" autocomplete="off"
               placeholder="How it is said" aria-label="How it is said"
               data-i18n-attr="placeholder:ln.target,aria-label:ln.target">
        <button type="submit" class="ghost-btn" data-i18n="ln.add">Add</button>
      </form>
    </div>
  </section>
</div>

{#- Each language's own name, from its file. The list of languages itself
   comes from the server (site.json on the content branch), which knows about
   a language added a minute ago; this only supplies the names it can. -#}
<script id="lnLangs" type="application/json">[{% for code in site.languages %}{"code": {{ code | dump | safe }}, "name": {{ (i18n[code].name if i18n[code] else code) | dump | safe }}}{% if not loop.last %},{% endif %}{% endfor %}]</script>
