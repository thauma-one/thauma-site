---
layout: layouts/base.njk
pagination:
  data: site.languages
  size: 1
  alias: lang
pageSlug: "about"
pageTitle: about
---
{% set t = i18n[lang] %}
<header class="dict"><div class="wrap">
  <div class="dict-word rise">{{ t.about.dict_word }}</div>
  <div class="dict-ipa rise-2">{{ t.about.dict_ipa }}</div>
  <div class="dict-defs rise-3">
    <p>{{ t.about.dict_def1 }}</p>
    <p>{{ t.about.dict_def2 }}</p>
    <p>{{ t.about.dict_def3 }}</p>
  </div>
</div></header>

<section><div class="wrap">
  <div class="cue">{{ t.about.who_cue }}</div>
  <h2>{{ t.about.who_h2_thin }} <b>{{ t.about.who_h2_bold }}</b></h2>
  <p class="body-text">{{ t.about.body1 }}</p>
  <p class="body-text">{{ t.about.body2 }}</p>
</div></section>

<section class="alt"><div class="wrap">
  <div class="cue foam">{{ t.about.posture_cue }}</div>
  <h2>{{ t.about.posture_h2_thin }} <b>{{ t.about.posture_h2_bold }}</b></h2>
  <p class="body-text">{{ t.about.body3 }}</p>
  {% if site.images.about_posture.src %}
  <div class="frame">
    <img src="{{ site.images.about_posture.src }}" alt="{{ t.about.posture_img_tag }}" loading="lazy"
      style="object-position:{{ site.images.about_posture.focal_x }}% {{ site.images.about_posture.focal_y }}%;transform-origin:{{ site.images.about_posture.focal_x }}% {{ site.images.about_posture.focal_y }}%;transform:scale({{ site.images.about_posture.zoom / 100 }})">
    <span class="tag">{{ t.about.posture_img_tag }}</span>
  </div>
  {% elif not env.isProduction %}
  <div class="frame-placeholder"><span>{{ t.about.posture_placeholder }}</span></div>
  {% endif %}
  <p class="legal-note">{{ t.about.status_note }}</p>
</div></section>
