---
layout: layouts/base.njk
pagination:
  data: activeLangs
  size: 1
  alias: lang
pageSlug: "resources"
pageTitle: resources
---
{% set t = i18n[lang] %}
{#- The library, as its own switch. `resourcesLibrary` decides whether the
   real grid shows or the "coming soon" block does — separately from whether
   the Resources PAGE exists at all, which is `visible.pages.resources`.

   It no longer says "or not env.isProduction". That escape hatch meant the
   dev site could never show the unrevealed state, so there was no way to
   check what a visitor saw before launch. The dev column does that job now,
   and it defaults to revealed. #}
{% set resourcesRevealed = visible.sections.resourcesLibrary %}
<header class="page"><div class="wrap">
  <div class="cue rise">{{ t.resources.cue }}</div>
  <h2 class="rise-2">{{ t.resources.h2_thin }} <b>{{ t.resources.h2_bold }}</b></h2>
</div></header>

<section><div class="wrap">
  {% if resourcesRevealed and resources.length %}
  <div class="resource-grid">
    {% for r in resources %}
    <div class="resource-card">
      {% if r.photo %}<div class="resource-photo"><img src="{{ r.photo }}" alt="{{ r.title[lang] }}" loading="lazy" decoding="async"></div>{% endif %}
      <h3>{{ r.title[lang] }}</h3>
      {% if r.description[lang] %}<p>{{ r.description[lang] | md | safe }}</p>{% endif %}
      {% if r.link %}<a class="btn ghost" href="{{ r.link }}" target="_blank" rel="noopener">{{ t.resources.link_label }}</a>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% else %}
  <div class="empty">
    <h3>{{ t.resources.empty_title }}</h3>
    <p>{{ t.resources.empty_text }}</p>
    <div class="workline"><i></i></div>
    <a class="btn ghost" href="/{{ lang }}/contact/">{{ t.resources.empty_cta }}</a>
  </div>
  {% endif %}
</div></section>
