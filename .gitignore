node_modules/
_site/
.DS_Store

# Local Netlify folder
.netlify

# Local secrets (Blobs access token, etc.) — never committed
.env

# Regenerable debug renders (scripts/render-collage-debug.js) — approved
# visuals get saved as <feature>-approved.png instead, which IS committed.
collage-debug.png
collage-debug.svg

# Staging build for the Workers deploy (full/gated per site.json, like production)
_site_next/
__pycache__/

# wrangler dev's local state — the simulated D1/KV for dev.thauma.one.
# Reproducible from db/seed.dev.sql; never a source of truth.
.wrangler/
_site_prod/

# LOCAL SECRETS. `wrangler dev` reads these; they must never be committed.
#
# .dev.vars can hold the GitHub App private key, which can commit to this
# repository and deploy the live site. A key in git history is permanent — a
# later delete does not remove it from the objects, and any clone taken in the
# meantime still has it. Rotating is the only real remedy.
#
# Added 2026-08-17, before the file existed, because noticing this afterwards
# would have meant generating a new key rather than editing a line.
.dev.vars
.dev.vars.*
*.pem

# Build output. Regenerated by the Eleventy build, in CI and on the Pi.
src/js/*.bundle.js

# Presentation build output. The site build regenerates it into _site/present/,
# so a committed copy is only ever a stale duplicate.
presentation/dist/

# Screenshots taken while working on the site (chromium --headless --screenshot).
# They live INSIDE the repo so a session scoped to this folder can see them, and are
# ignored because they are throwaway renders of whatever the dev server served that
# minute. An image worth keeping goes in src/img/ or docs/ with a real name.
# The README is kept so a fresh clone has the folder and the how-to.
screenshots/*
!screenshots/README.md
