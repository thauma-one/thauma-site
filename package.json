{
  "name": "thauma-site",
  "version": "1.0.0",
  "description": "Thauma ministry website \u2014 Eleventy + Decap CMS + Netlify",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true})\" && eleventy",
    "dev": "eleventy --serve --port 8123",
    "cms-proxy": "decap-server",
    "collage-debug": "node scripts/render-collage-debug.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "decap-server": "^3.9.1",
    "sharp": "^0.35.3",
    "wrangler": "4.86.0"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.9",
    "image-size": "^2.0.2"
  }
}
