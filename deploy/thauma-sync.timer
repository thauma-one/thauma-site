# Every five minutes. Frequent enough that a failed webhook is a five-minute
# annoyance rather than a mystery, rare enough to be free.
#
# Persistent=true so a Pi that was off catches up on boot instead of waiting
# for the next slot.
[Unit]
Description=Pull thauma from GitHub every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target
